node_modules/

# 抓取原始转储（体积大，每次运行重新生成）
fc27_dump.json

# 图片暂存目录（下载后立刻上传云存储并删除，不进仓库）
images_out/

# 无半身像卡面本地产物（上传云存储即可，320 张约 9MB，不进仓库）
_np_out/

# 增量落库包（每次运行重新生成，仅供 upload_db.js 读取）
cloud-data/fc*/incremental.json

# 旧版「小程序本地兜底」文件：现在是数据库架构，CI 不再生成（--no-local）
data/*
# 例外：译名对照表是 CI 的 sync_i18n.js 输入，必须入库（否则 CI 翻不出新译名）
!data/country-zh.json
!data/i18n-names.json
# 例外：包内词典快照（eafc-miniapp 侧生成）。CI 只 checkout 本仓库、拿不到 miniapp 源码，
# sync_i18n.js 必须靠它，缺了会被 BUNDLE_MIN 守卫拦下（见 2026-09-16 CI 修复）。
!data/i18n-bundle.json

# 本地云开发凭证（绝不提交；CI 走 GitHub Secrets）
.env.local
.env
.tcb.local.json

.DS_Store

# 凭证文件（切勿提交）
.gh_token
.gh_token.txt
*.gh_token

# ⚠️ R29k 共享扫描缓存（2026-09-27）：sync_i18n 扫全表时落盘，warm_roster / gen_squad_chem
#   用 --from-cache 读，把「三个脚本各扫一遍」变成「只扫一遍」（59,580 → 19,860 数据库读/天）。
#   体积 ≈19,860 条 × 469 B ≈ 8.9MB —— **必须忽略**，否则被 git 跟踪 ⇒ 仓库爆炸、每次 commit 都拖 9MB。
#   它只是「同一次 CI job 内的中转产物」，删了不影响任何东西（消费方会自动退化成自己扫）。
cloud-data/fc27/_scan_cache.json
